rules_version = '2';

// Phase 1: only user profiles exist. Room rules arrive in later phases.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
