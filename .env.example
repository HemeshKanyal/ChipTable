# --- Local development with the Firebase Emulator Suite (default) ---
# With emulators on, the values below can stay as-is: "demo-" projects never
# touch a real Firebase project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# Host the browser uses to reach the emulators. Leave empty to use the host the
# page was loaded from (handy when testing from a phone on your LAN).
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=
# Only if you run the emulators on non-default ports (firebase.json uses 9099 / 8080).
NEXT_PUBLIC_AUTH_EMULATOR_PORT=
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=

# --- Firebase web app config (Project settings > General > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-chiptable.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-chiptable
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated extra hostnames allowed to load the dev server (e.g. your LAN IP).
DEV_ORIGINS=
